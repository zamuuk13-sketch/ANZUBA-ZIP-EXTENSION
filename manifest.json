{
  "manifest_version": 3,
  "name": "ANZUBA ZIP",
  "version": "3.0.0",
  "description": "Ponte entre Gemini/DeepSeek e projetos em ZIP.",
  "permissions": [],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://deepseek.com/*",
    "https://chat.deepseek.com/*"
  ],
  "action": {
    "default_title": "ANZUBA ZIP",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://deepseek.com/*",
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/folder.svg",
    "32": "icons/folder.svg",
    "48": "icons/folder.svg",
    "128": "icons/folder.svg"
  }
}